{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vscode"],
    "outDir": "dist"
  },
  "include": ["src/extension/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts", "esbuild.config.mjs", "vite.config.ts"]
}
