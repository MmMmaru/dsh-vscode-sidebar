{
  "name": "dsh-vscode-sidebar",
  "displayName": "DeepSeek Harness Sidebar",
  "description": "VSCode sidebar client for the DeepSeek harness (dsh) web host",
  "version": "0.1.5",
  "publisher": "XuRongSheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MmMmaru/dsh-vscode-sidebar.git"
  },
  "private": true,
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DeepSeek",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.sidebar",
          "name": "Chats",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.newChat",
        "title": "New Chat",
        "category": "DSH"
      },
      {
        "command": "dsh.openSettings",
        "title": "Open Settings",
        "category": "DSH"
      },
      {
        "command": "dsh.openFullPanel",
        "title": "Open Full Panel",
        "category": "DSH"
      },
      {
        "command": "dsh.insertSelection",
        "title": "插入选中内容到对话",
        "category": "DSH"
      },
      {
        "command": "dsh.insertActiveFile",
        "title": "插入当前文件到对话",
        "category": "DSH"
      }
    ],
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.port": {
          "type": "number",
          "default": 3080,
          "description": "Base port for the local dsh web host; occupied ports are skipped in order."
        },
        "dsh.token": {
          "type": "string",
          "default": "",
          "description": "Optional authentication token used when connecting to an existing dsh web host requiring Bearer token auth."
        },
        "dsh.keepHostOnExit": {
          "type": "boolean",
          "default": false,
          "description": "Keep the dsh host process alive when VSCode shuts down (only applies when the extension spawned it)."
        },
        "dsh.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Custom environment variables for the dsh host process this extension spawns (KEY -> value), editable from the extension's Settings tab under General. They are merged over the extension host's own environment, so `PATH` and friends stay inherited. A host that is already running keeps its old environment: restart the host (or reload the window) for changes to take effect."
        }
      }
    }
  },
  "dsh": {
    "compatibleVersionPrefixes": [
      "0.1.",
      "0.0.1"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node esbuild.config.mjs --tests && node --test .temp/test-dist/*.test.mjs",
    "smoke": "node esbuild.config.mjs --smoke && node .temp/smoke-dist/smoke.mjs",
    "verify:mock": "esbuild .temp/verify-mock.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.temp/verify-mock.mjs --log-level=warning && node .temp/verify-mock.mjs",
    "verify:overlay": "esbuild .temp/verify-w5-overlay.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.temp/verify-w5-overlay.mjs --log-level=warning && node .temp/verify-w5-overlay.mjs",
    "verify:w6": "esbuild .temp/verify-w6-settings.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.temp/verify-w6-settings.mjs --log-level=warning && node .temp/verify-w6-settings.mjs",
    "test:e2e": "npm run build:webview && node esbuild.config.mjs --e2e && LD_LIBRARY_PATH=.temp/libs/root/usr/lib/x86_64-linux-gnu playwright test",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  }
}
